---
import Header from "../components/Header.astro"
import "../styles/global.css"

interface Props {
  title?: string;
}

const { title = "Tailspin Toys" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <!-- Preconnect to improve font loading -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    </head>
    <body class="min-h-screen bg-slate-950 text-white transition-colors duration-300 m-0 w-full h-full font-sans relative overflow-x-hidden">
        <!-- Enhanced background with multiple layers -->
        <div class="fixed inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 -z-50"></div>
        <div class="fixed inset-0 bg-gradient-to-tr from-blue-950/20 via-transparent to-purple-950/20 -z-40"></div>
        
        <!-- Animated background elements -->
        <div class="fixed inset-0 overflow-hidden pointer-events-none -z-30">
            <!-- Large floating orbs -->
            <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-gradient-to-r from-blue-600/10 to-purple-600/10 rounded-full blur-3xl animate-float" style="animation-delay: 0s;"></div>
            <div class="absolute top-3/4 right-1/4 w-80 h-80 bg-gradient-to-r from-purple-600/10 to-indigo-600/10 rounded-full blur-3xl animate-float" style="animation-delay: 3s;"></div>
            <div class="absolute bottom-1/4 left-1/3 w-64 h-64 bg-gradient-to-r from-indigo-600/10 to-blue-600/10 rounded-full blur-3xl animate-float" style="animation-delay: 6s;"></div>
            
            <!-- Grid pattern overlay -->
            <div class="absolute inset-0 bg-[linear-gradient(rgba(59,130,246,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(59,130,246,0.03)_1px,transparent_1px)] bg-[size:50px_50px]"></div>
        </div>
        
        <Header />
        <main class="container mx-auto py-6 h-full max-w-7xl relative z-10">
            <div class="px-4 sm:px-6 lg:px-8">
                <slot />
            </div>
        </main>
        
        <!-- Enhanced footer -->
        <footer class="relative mt-20 border-t border-slate-800/50 bg-slate-900/30 backdrop-blur-sm">
            <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                    <!-- Brand section -->
                    <div class="md:col-span-2">
                        <div class="flex items-center mb-4">
                            <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-500 rounded-lg flex items-center justify-center mr-3">
                                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 2L2 7v10c0 5.55 3.84 9.74 9 11 5.16-1.26 9-5.45 9-11V7l-10-5z"/>
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold gradient-text">Tailspin Toys</h3>
                        </div>
                        <p class="text-slate-400 mb-6 max-w-md">
                            The premier crowdfunding platform for developer-themed board games. 
                            Where coding meets creativity.
                        </p>
                        <div class="flex gap-4">
                            <a href="#" class="w-10 h-10 bg-slate-800/50 hover:bg-blue-600/20 rounded-lg flex items-center justify-center transition-colors duration-300 group">
                                <svg class="w-5 h-5 text-slate-400 group-hover:text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                                </svg>
                            </a>
                            <a href="#" class="w-10 h-10 bg-slate-800/50 hover:bg-purple-600/20 rounded-lg flex items-center justify-center transition-colors duration-300 group">
                                <svg class="w-5 h-5 text-slate-400 group-hover:text-purple-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.174-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.120.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.402.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.357-.629-2.761-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24.009 12.017 24.009c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001.012.001z"/>
                                </svg>
                            </a>
                            <a href="#" class="w-10 h-10 bg-slate-800/50 hover:bg-indigo-600/20 rounded-lg flex items-center justify-center transition-colors duration-300 group">
                                <svg class="w-5 h-5 text-slate-400 group-hover:text-indigo-400" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599-.262.793-.113.793-.351v-2.292c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                    
                    <!-- Quick links -->
                    <div>
                        <h4 class="text-lg font-semibold text-slate-200 mb-4">Quick Links</h4>
                        <ul class="space-y-2 text-slate-400">
                            <li><a href="/" class="hover:text-blue-400 transition-colors duration-300">Home</a></li>
                            <li><a href="/about" class="hover:text-blue-400 transition-colors duration-300">About</a></li>
                            <li><a href="#" class="hover:text-blue-400 transition-colors duration-300">Games</a></li>
                            <li><a href="#" class="hover:text-blue-400 transition-colors duration-300">Support</a></li>
                        </ul>
                    </div>
                    
                    <!-- Community -->
                    <div>
                        <h4 class="text-lg font-semibold text-slate-200 mb-4">Community</h4>
                        <ul class="space-y-2 text-slate-400">
                            <li><a href="#" class="hover:text-purple-400 transition-colors duration-300">Discord</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors duration-300">Forums</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors duration-300">Blog</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors duration-300">Newsletter</a></li>
                        </ul>
                    </div>
                </div>
                
                <!-- Copyright -->
                <div class="mt-12 pt-8 border-t border-slate-800/50 text-center text-slate-500">
                    <p>&copy; 2024 Tailspin Toys. Let's game from here, together!</p>
                </div>
            </div>
        </footer>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    }
    
    html {
        font-family: var(--font-sans);
        scroll-behavior: smooth;
    }
    
    body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    
    /* Enhanced focus styles */
    *:focus {
        outline: 2px solid transparent;
        outline-offset: 2px;
    }
    
    *:focus-visible {
        outline: 2px solid rgb(59 130 246 / 0.5);
        outline-offset: 2px;
    }
</style>
