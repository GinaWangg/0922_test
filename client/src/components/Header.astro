---
// Import any necessary dependencies
---

<header class="relative bg-slate-900/80 backdrop-blur-xl border-b border-slate-800/50 text-white shadow-2xl sticky top-0 z-50">
  <!-- Background Effects -->
  <div class="absolute inset-0 bg-gradient-to-r from-blue-600/5 via-purple-600/5 to-teal-600/5"></div>
  <div class="absolute top-0 left-1/3 w-64 h-32 bg-blue-500/5 rounded-full blur-3xl"></div>
  <div class="absolute top-0 right-1/3 w-64 h-32 bg-purple-500/5 rounded-full blur-3xl"></div>
  
  <div class="relative container mx-auto flex justify-between items-center px-6 py-4">
    <div class="flex items-center">
      <div class="relative group">
        <button id="menu-toggle" class="focus:outline-none mr-6 p-2 rounded-xl bg-slate-800/50 hover:bg-slate-700/50 border border-slate-700/50 hover:border-slate-600/50 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform transition-transform duration-300 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        
        <!-- Enhanced Dropdown Menu -->
        <nav id="menu" class="hidden absolute left-0 mt-4 w-64 bg-slate-800/95 backdrop-blur-xl text-white rounded-2xl shadow-2xl border border-slate-700/50 z-20 overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-600/10 to-purple-600/10"></div>
          <ul class="relative py-2">
            <li>
              <a href="/" class="group flex items-center px-6 py-4 hover:bg-slate-700/50 transition-all duration-300 text-slate-200 hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-blue-400 group-hover:text-blue-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span class="font-medium">Home</span>
              </a>
            </li>
            <li>
              <a href="/about" class="group flex items-center px-6 py-4 hover:bg-slate-700/50 transition-all duration-300 text-slate-200 hover:text-white">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3 text-purple-400 group-hover:text-purple-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="font-medium">About</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
      
      <!-- Enhanced Logo -->
      <div class="flex items-center">
        <div class="mr-4 p-3 bg-gradient-to-br from-blue-600 to-purple-600 rounded-xl shadow-lg">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <h1 class="text-2xl font-bold">
          <a href="/" class="hover:text-blue-400 transition-colors duration-300 bg-gradient-to-r from-white to-blue-100 bg-clip-text text-transparent hover:from-blue-400 hover:to-purple-400">
            Tailspin Toys
          </a>
        </h1>
      </div>
    </div>
    
    <!-- Action Buttons -->
    <div class="flex items-center space-x-4">
      <button class="px-4 py-2 text-slate-300 hover:text-white font-medium rounded-lg hover:bg-slate-800/50 transition-all duration-300">
        Login
      </button>
      <button class="px-6 py-2 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold rounded-lg shadow-lg hover:shadow-blue-500/20 transition-all duration-300 transform hover:scale-105">
        Sign Up
      </button>
    </div>
  </div>
</header>

<script>
  // Toggle menu visibility when hamburger is clicked
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  
  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const isClickInside = menuToggle.contains(event.target as Node) || menu.contains(event.target as Node);
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
      }
    });
  }
</script>