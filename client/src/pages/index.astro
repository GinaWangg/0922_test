---
import Layout from '../layouts/Layout.astro';
import GameList from '../components/GameList.svelte';
import "../styles/global.css";
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <!-- Hero Section with Enhanced Styling -->
  <div class="relative overflow-hidden">
    <!-- Background Elements -->
    <div class="absolute inset-0 bg-gradient-to-br from-blue-600/5 via-purple-600/5 to-teal-600/5"></div>
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"></div>
    
    <!-- Hero Content -->
    <div class="relative py-16 lg:py-24">
      <div class="text-center max-w-5xl mx-auto mb-16">
        <div class="mb-6">
          <span class="inline-block px-4 py-2 bg-gradient-to-r from-blue-600/20 to-purple-600/20 border border-blue-500/30 rounded-full text-blue-300 text-sm font-medium backdrop-blur-sm">
            🎮 Developer-Themed Games
          </span>
        </div>
        
        <h1 class="text-5xl lg:text-7xl font-bold mb-8 bg-gradient-to-r from-blue-400 via-purple-400 to-teal-400 bg-clip-text text-transparent leading-tight">
          Welcome to<br />
          <span class="bg-gradient-to-r from-white via-blue-100 to-white bg-clip-text text-transparent">Tailspin Toys</span>
        </h1>
        
        <p class="text-xl lg:text-2xl text-slate-300 max-w-3xl mx-auto leading-relaxed mb-8">
          Discover and fund the next generation of <span class="text-blue-400 font-semibold">developer-themed board games</span>. 
          From CI/CD adventures to DevOps challenges, find your perfect game!
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <button class="px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold rounded-xl shadow-lg hover:shadow-blue-500/20 hover:shadow-2xl transition-all duration-300 transform hover:scale-105">
            Explore Games
          </button>
          <button class="px-8 py-4 bg-slate-800/50 hover:bg-slate-700/50 text-slate-300 hover:text-white font-semibold rounded-xl border border-slate-600 hover:border-slate-500 backdrop-blur-sm transition-all duration-300">
            Learn More
          </button>
        </div>
      </div>
      
      <!-- Stats Section -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto mb-16">
        <div class="text-center p-6 bg-slate-800/30 backdrop-blur-sm rounded-2xl border border-slate-700/50">
          <div class="text-3xl font-bold text-blue-400 mb-2">50+</div>
          <div class="text-slate-300 font-medium">Active Projects</div>
        </div>
        <div class="text-center p-6 bg-slate-800/30 backdrop-blur-sm rounded-2xl border border-slate-700/50">
          <div class="text-3xl font-bold text-purple-400 mb-2">$2.5M</div>
          <div class="text-slate-300 font-medium">Raised</div>
        </div>
        <div class="text-center p-6 bg-slate-800/30 backdrop-blur-sm rounded-2xl border border-slate-700/50">
          <div class="text-3xl font-bold text-teal-400 mb-2">10K+</div>
          <div class="text-slate-300 font-medium">Backers</div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Games Section -->
  <div class="relative">
    <GameList client:only="svelte" />
  </div>
</Layout>
